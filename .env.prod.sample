# ============================================================
# Novel Vibe — Production Environment Variables
# ============================================================
# Copy: cp .env.prod.sample .env.prod && chmod 600 .env.prod
# Generate secrets: openssl rand -base64 32

# ---- Domains and certificates ----
# The certificate paths below point at files *on the deployment host*, not at files in this
# repository: TLS material lives in the private ops repository and is provisioned on the server.
MAIN_DOMAIN=lingqiai.art
WWW_DOMAIN=www.lingqiai.art
APP_DOMAIN=app.lingqiai.art
MAIN_SSL_CERT=/etc/nginx/ssl/lingqiai.art.crt
MAIN_SSL_KEY=/etc/nginx/ssl/lingqiai.art.key
APP_SSL_CERT=/etc/nginx/ssl/app.lingqiai.art.crt
APP_SSL_KEY=/etc/nginx/ssl/app.lingqiai.art.key

# ---- InsForge access tokens ----
# Lifetime of the access token InsForge issues on sign-in (jsonwebtoken format, e.g. 15m / 8h).
# Left empty on purpose: unset means upstream's default of 15m. The hosted deployment sets a
# longer value deliberately, so set one here before deploying — an unset value silently shortens
# every sign-in session. Rebuild the InsForge image after changing it.
ACCESS_TOKEN_EXPIRES_IN=

# ---- Browser session ----
NOVEL_VIBE_SESSION_COOKIE=__Secure-novel_session
NOVEL_VIBE_SESSION_COOKIE_DOMAIN=lingqiai.art
NOVEL_VIBE_ALLOWED_ORIGINS=https://lingqiai.art,https://app.lingqiai.art

# ---- PostgreSQL ----
POSTGRES_USER=postgres
POSTGRES_PASSWORD=<generate-32-char-random>
POSTGRES_DB=insforge

# ---- Scheduler email notifications ----
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_EMAIL=admin@example.com
SMTP_PASSWORD=<smtp-app-password>

# ---- JWT / Encryption ----
JWT_SECRET=<generate-64-char-random>
ENCRYPTION_KEY=<same-as-jwt-secret-or-separate>
INSFORGE_ACCESS_KEY=ik_<generate-32-char-minimum>

# ---- InsForge Admin ----
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=<generate-strong-password>

# ---- LLM Provider ----
LLM_PROVIDER=opencode
LLM_MODEL=deepseek-v4-flash-free
OPENCODE_API_KEY=sk-<your-opencode-zen-api-key>
# Keep false for shadow synchronization; enable only after inspecting runtime catalog rows.
OPENCODE_DYNAMIC_MODELS_ENABLED=false
DEEPSEEK_API_KEY=sk-<your-deepseek-api-key>
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# ---- Memori (optional, agent memory) ----
# MEMORI_API_KEY=<your-memori-api-key>

# ---- S3 Storage (optional — uses local storage if unset) ----
# AWS_ACCESS_KEY_ID=<your-aws-key>
# AWS_SECRET_ACCESS_KEY=<your-aws-secret>
# AWS_S3_BUCKET=<your-bucket-name>
# AWS_REGION=us-east-1

# ---- OAuth (optional) ----
# GOOGLE_CLIENT_ID=<your-google-client-id>
# GOOGLE_CLIENT_SECRET=<your-google-client-secret>
# GITHUB_CLIENT_ID=<your-github-client-id>
# GITHUB_CLIENT_SECRET=<your-github-client-secret>

# ---- Z-Pay Payment ----
ZPAY_PID=<your-zpay-pid>
ZPAY_KEY=<your-zpay-key>
ZPAY_NOTIFY_URL=https://<your-domain>/api/payments/zpay/notify
ZPAY_RETURN_URL=https://<your-domain>/profile

# ---- Search indexing (optional; publishing still succeeds if unset) ----
# Generate with: openssl rand -hex 16
INDEXNOW_KEY=<generate-indexnow-key>
INDEXNOW_ENDPOINT=https://api.indexnow.org/indexnow
INDEXNOW_HOST=lingqiai.art
INDEXNOW_KEY_LOCATION=https://lingqiai.art/<INDEXNOW_KEY>.txt

# Copy the exact site and token from 百度搜索资源平台 → 普通收录 → API提交.
BAIDU_PUSH_SITE=https://lingqiai.art
BAIDU_PUSH_TOKEN=<your-baidu-push-token>
BAIDU_PUSH_ENDPOINT=http://data.zz.baidu.com/urls

# ---- File size limits ----
MAX_FILE_SIZE=100mb
